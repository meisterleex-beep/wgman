#!/usr/bin/env bash
set -uo pipefail

WGMAN_VER="2.14"
WG_DIR="/opt/wgman"
STATE_DIR="$WG_DIR/state"
CLIENTS_DIR="$STATE_DIR/clients"
PEERS_FILE="$STATE_DIR/peers"
TOKEN_FILE="$STATE_DIR/token"
CONFIG_FILE="$STATE_DIR/config"
CONF="/etc/wireguard/wg0.conf"
SERVER_KEY_FILE="/etc/wireguard/server.key"
SERVER_PUB_FILE="/etc/wireguard/server.pub"

NET="10.66.66"
PREFIX="24"
PORT="51820"
API_PORT="51821"
DNS1="1.1.1.1"
DNS2="8.8.8.8"
SERVER_HOST=""
AWG=0
AWG_NET="10.66.77"
AWG_PREFIX="24"
AWG_PORT="51823"
AWG_MTU="1420"
AWG_JC="50"
AWG_JMIN="5"
AWG_JMAX="5"
AWG_S1="0"
AWG_S2="0"
AWG_H1="2048"
AWG_H2="4096"
AWG_H3="8192"
AWG_H4="16384"
AWG_UP="/usr/local/bin/awg0-up.sh"
AWG_DOWN="/usr/local/bin/awg0-down.sh"
AWG_RUN="/usr/local/bin/awg0-run.sh"
AWG_SERVICE="/etc/systemd/system/awg0.service"
AWG_MODE="auto"

usage() {
  cat <<'EOF'
wgman - WireGuard manager for OpenWrt routers

Usage:
  wgman install [--host HOST] [--port PORT] [--net X.X.X] [--prefix N]
  wgman add <name> [--awg]           create config for a PC client (AmneziaWG with --awg)
  wgman client <name>                (re)build a client config (routes to all router LANs)
  wgman routers                     list routers
  wgman list                        list all peers
  wgman ip <name>                   show the WG IP of a peer
  wgman remove <name|ip>            remove a peer
  wgman token [new]                 show or rotate the API token
  wgman host <host>                 set public endpoint host of the server
  wgman router <name>               show peer info for a router
  wgman router-new <name> [lan]     create a router peer + generate its config
  wgman config <name>               print the config of a client or router
  wgman awg <on|off|status>         enable/disable the AmneziaWG tunnel (awg0)
  wgman enable <name>               enable a peer (route it again, resolves LAN conflicts)
  wgman disable <name>              disable a peer (exclude its routes)
EOF
}

load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
}

detect_main_iface() {
  local iface
  iface=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
  if [ -z "$iface" ]; then
    iface=$(ip -o -4 addr show 2>/dev/null | awk '$2 != "lo" {print $2; exit}')
  fi
  echo "$iface"
}

kernel_has_awg() {
  ip link del awgtest 2>/dev/null
  if ip link add dev awgtest type amneziawg 2>/dev/null; then
    ip link del awgtest 2>/dev/null
    return 0
  fi
  modprobe amneziawg 2>/dev/null
  if ip link add dev awgtest type amneziawg 2>/dev/null; then
    ip link del awgtest 2>/dev/null
    return 0
  fi
  return 1
}

next_ip() {
  local net=$1 i used
  used=$(awk -F'|' 'NF {print $3}' "$PEERS_FILE" 2>/dev/null)
  for i in $(seq 2 254); do
    if ! grep -qx "$net.$i" <<< "$used"; then
      echo "$net.$i"
      return 0
    fi
  done
  return 1
}

net_of() {
  local ip cidr a b c d n mask
  ip=${1%/*}
  cidr=${1#*/}
  IFS=. read -r a b c d <<< "$ip"
  n=$(( (a<<24) | (b<<16) | (c<<8) | d ))
  if [ "$cidr" -eq 0 ]; then
    mask=0
  else
    mask=$(( ( (1<<cidr) - 1 ) << (32 - cidr) ))
  fi
  n=$(( n & mask ))
  printf '%d.%d.%d.%d/%d' $(( (n>>24)&255 )) $(( (n>>16)&255 )) $(( (n>>8)&255 )) $(( n&255 )) "$cidr"
}

write_wg_conf() {
  local main_iface server_key
  main_iface=$(detect_main_iface)
  server_key=$(cat "$SERVER_KEY_FILE")
  {
    echo "[Interface]"
    echo "Address = $NET.1/$PREFIX"
    echo "ListenPort = $PORT"
    echo "PrivateKey = $server_key"
    echo "PostUp = iptables -t nat -A POSTROUTING -s $NET.0/$PREFIX -o $main_iface -j MASQUERADE"
    echo "PostUp = iptables -I INPUT -i wg0 -j ACCEPT"
    echo "PostUp = iptables -I FORWARD -i wg0 -o wg0 -j ACCEPT"
    echo "PostUp = iptables -I FORWARD -i wg0 -o $main_iface -j ACCEPT"
    echo "PostUp = iptables -I FORWARD -i $main_iface -o wg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    echo "PostDown = iptables -D INPUT -i wg0 -j ACCEPT"
    echo "PostDown = iptables -D FORWARD -i wg0 -o wg0 -j ACCEPT"
    echo "PostDown = iptables -D FORWARD -i wg0 -o $main_iface -j ACCEPT"
    echo "PostDown = iptables -D FORWARD -i $main_iface -o wg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    while IFS='|' read -r pname ppub pip plan pep ptype _ proto pen _; do
      [ -z "$pname" ] && continue
      [ "$proto" = "awg" ] && continue
      [ "$pen" = "0" ] && continue
      echo ""
      echo "[Peer]"
      echo "PublicKey = $ppub"
      if [ -n "$plan" ]; then
        echo "AllowedIPs = $pip/32, $(net_of "$plan")"
      else
        echo "AllowedIPs = $pip/32"
      fi
      [ -n "$pep" ] && echo "Endpoint = $pep"
      echo "PersistentKeepalive = 25"
    done < "$PEERS_FILE"
  } > "$CONF"
}

write_awg_up() {
  local main_iface server_key
  main_iface=$(detect_main_iface)
  server_key=$(cat "$SERVER_KEY_FILE")
  if [ "${AWG_MODE:-auto}" = "native" ]; then
    {
      echo '#!/usr/bin/env bash'
      echo 'set -e'
      echo 'ip link del awgtest 2>/dev/null || true'
      echo 'ip link show awg0 >/dev/null 2>&1 || ip link add dev awg0 type amneziawg'
      echo "awg set awg0 listen-port $AWG_PORT private-key <(printf '%s' '$server_key') jc $AWG_JC jmin $AWG_JMIN jmax $AWG_JMAX s1 $AWG_S1 s2 $AWG_S2 h1 $AWG_H1 h2 $AWG_H2 h3 $AWG_H3 h4 $AWG_H4"
      while IFS='|' read -r pname ppub pip plan pep ptype _ proto pen _; do
        [ -z "$pname" ] && continue
        [ "$proto" = "awg" ] || continue
        [ "$pen" = "0" ] && continue
        ai="$pip/32"
        [ -n "$plan" ] && ai="$pip/32, $(net_of "$plan")"
        echo "awg set awg0 peer '$ppub' allowed-ips '$ai' persistent-keepalive 25"
      done < "$PEERS_FILE"
      echo "ip addr replace $AWG_NET.1/$AWG_PREFIX dev awg0 2>/dev/null || ip addr add $AWG_NET.1/$AWG_PREFIX dev awg0"
      echo "ip link set dev awg0 up"
      while IFS='|' read -r pname ppub pip plan pep ptype _ proto pen _; do
        [ -z "$pname" ] && continue
        [ "$proto" = "awg" ] || continue
        [ "$pen" = "0" ] && continue
        echo "ip route replace $pip/32 dev awg0"
        [ -n "$plan" ] && echo "ip route replace $(net_of "$plan") dev awg0"
      done < "$PEERS_FILE"
      echo "iptables -C INPUT -p udp --dport $AWG_PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport $AWG_PORT -j ACCEPT"
    } > "$AWG_UP"
  else
    {
      echo '#!/usr/bin/env bash'
      echo 'set -e'
      echo 'SOCK=/var/run/amneziawg/awg0.sock'
      echo 'for i in $(seq 1 20); do [ -S "$SOCK" ] && break; sleep 1; done'
      echo '[ -S "$SOCK" ] || { echo "amneziawg-go UAPI socket not ready"; exit 1; }'
      echo "awg set awg0 listen-port $AWG_PORT private-key <(printf '%s' '$server_key') jc $AWG_JC jmin $AWG_JMIN jmax $AWG_JMAX s1 $AWG_S1 s2 $AWG_S2 h1 $AWG_H1 h2 $AWG_H2 h3 $AWG_H3 h4 $AWG_H4"
      while IFS='|' read -r pname ppub pip plan pep ptype _ proto pen _; do
        [ -z "$pname" ] && continue
        [ "$proto" = "awg" ] || continue
        [ "$pen" = "0" ] && continue
        ai="$pip/32"
        [ -n "$plan" ] && ai="$pip/32, $(net_of "$plan")"
        echo "awg set awg0 peer '$ppub' allowed-ips '$ai' persistent-keepalive 25"
      done < "$PEERS_FILE"
      echo "ip addr replace $AWG_NET.1/$AWG_PREFIX dev awg0 2>/dev/null || ip addr add $AWG_NET.1/$AWG_PREFIX dev awg0"
      echo "ip link set dev awg0 up"
      while IFS='|' read -r pname ppub pip plan pep ptype _ proto pen _; do
        [ -z "$pname" ] && continue
        [ "$proto" = "awg" ] || continue
        [ "$pen" = "0" ] && continue
        echo "ip route replace $pip/32 dev awg0"
        [ -n "$plan" ] && echo "ip route replace $(net_of "$plan") dev awg0"
      done < "$PEERS_FILE"
      echo "iptables -C INPUT -p udp --dport $AWG_PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport $AWG_PORT -j ACCEPT"
      echo "iptables -C INPUT -i awg0 -j ACCEPT 2>/dev/null || iptables -I INPUT -i awg0 -j ACCEPT"
      echo "iptables -C FORWARD -i awg0 -o awg0 -j ACCEPT 2>/dev/null || iptables -I FORWARD -i awg0 -o awg0 -j ACCEPT"
      echo "iptables -C FORWARD -i awg0 -o $main_iface -j ACCEPT 2>/dev/null || iptables -I FORWARD -i awg0 -o $main_iface -j ACCEPT"
      echo "iptables -C FORWARD -i $main_iface -o awg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || iptables -I FORWARD -i $main_iface -o awg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
      echo "iptables -t nat -C POSTROUTING -s $AWG_NET.0/$AWG_PREFIX -o $main_iface -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s $AWG_NET.0/$AWG_PREFIX -o $main_iface -j MASQUERADE"
    } > "$AWG_UP"
  fi
  chmod +x "$AWG_UP"
}

write_awg_down() {
  local main_iface
  main_iface=$(detect_main_iface)
  {
    echo '#!/usr/bin/env bash'
    echo 'set -e'
    echo 'ip link del awg0 2>/dev/null || true'
    echo "iptables -D INPUT -p udp --dport $AWG_PORT -j ACCEPT 2>/dev/null || true"
    echo "iptables -D INPUT -i awg0 -j ACCEPT 2>/dev/null || true"
    echo "iptables -D FORWARD -i awg0 -o awg0 -j ACCEPT 2>/dev/null || true"
    echo "iptables -D FORWARD -i awg0 -o $main_iface -j ACCEPT 2>/dev/null || true"
    echo "iptables -D FORWARD -i $main_iface -o awg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true"
    echo "iptables -t nat -D POSTROUTING -s $AWG_NET.0/$AWG_PREFIX -o $main_iface -j MASQUERADE 2>/dev/null || true"
  } > "$AWG_DOWN"
  chmod +x "$AWG_DOWN"
}

write_awg_run() {
  local server_key main_iface
  server_key=$(cat "$SERVER_KEY_FILE")
  main_iface=$(detect_main_iface)
  {
    echo '#!/usr/bin/env bash'
    echo 'set -e'
    echo 'rm -f /var/run/amneziawg/awg0.sock 2>/dev/null || true'
    echo 'ip link del awg0 2>/dev/null || true'
    echo 'export WG_PROCESS_FOREGROUND=1'
    echo 'export LOG_LEVEL=${LOG_LEVEL:-error}'
    echo '/usr/local/bin/amneziawg-go -f awg0 &'
    echo 'go_pid=$!'
    echo 'cleanup() { kill "$go_pid" 2>/dev/null || true; ip link del awg0 2>/dev/null || true; }'
    echo 'trap cleanup TERM INT EXIT'
    echo 'for i in $(seq 1 30); do [ -S /var/run/amneziawg/awg0.sock ] && break; sleep 1; done'
    echo '[ -S /var/run/amneziawg/awg0.sock ] || { echo "amneziawg-go failed to create UAPI socket"; exit 1; }'
    echo "awg set awg0 listen-port $AWG_PORT private-key <(printf '%s' '$server_key') jc $AWG_JC jmin $AWG_JMIN jmax $AWG_JMAX s1 $AWG_S1 s2 $AWG_S2 h1 $AWG_H1 h2 $AWG_H2 h3 $AWG_H3 h4 $AWG_H4"
    while IFS='|' read -r pname ppub pip plan pep ptype _ proto _; do
      [ -z "$pname" ] && continue
      [ "$proto" = "awg" ] || continue
      ai="$pip/32"
      [ -n "$plan" ] && ai="$pip/32, $(net_of "$plan")"
      echo "awg set awg0 peer '$ppub' allowed-ips '$ai' persistent-keepalive 25"
    done < "$PEERS_FILE"
    echo "ip addr replace $AWG_NET.1/$AWG_PREFIX dev awg0 2>/dev/null || ip addr add $AWG_NET.1/$AWG_PREFIX dev awg0"
    echo "ip link set dev awg0 up"
    while IFS='|' read -r pname ppub pip plan pep ptype _ proto _; do
      [ -z "$pname" ] && continue
      [ "$proto" = "awg" ] || continue
      echo "ip route replace $pip/32 dev awg0"
      [ -n "$plan" ] && echo "ip route replace $(net_of "$plan") dev awg0"
    done < "$PEERS_FILE"
    echo "iptables -C INPUT -p udp --dport $AWG_PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport $AWG_PORT -j ACCEPT"
    echo "iptables -C INPUT -i awg0 -j ACCEPT 2>/dev/null || iptables -I INPUT -i awg0 -j ACCEPT"
    echo "iptables -C FORWARD -i awg0 -o awg0 -j ACCEPT 2>/dev/null || iptables -I FORWARD -i awg0 -o awg0 -j ACCEPT"
    echo "iptables -C FORWARD -i awg0 -o $main_iface -j ACCEPT 2>/dev/null || iptables -I FORWARD -i awg0 -o $main_iface -j ACCEPT"
    echo "iptables -C FORWARD -i $main_iface -o awg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || iptables -I FORWARD -i $main_iface -o awg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    echo "iptables -t nat -C POSTROUTING -s $AWG_NET.0/$AWG_PREFIX -o $main_iface -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s $AWG_NET.0/$AWG_PREFIX -o $main_iface -j MASQUERADE"
    echo 'wait "$go_pid"'
  } > "$AWG_RUN"
  chmod +x "$AWG_RUN"
}

write_conf() {
  write_wg_conf
  if [ "${AWG:-0}" = "1" ]; then
    write_awg_down
    if [ "${AWG_MODE:-auto}" = "native" ]; then
      write_awg_up
    else
      write_awg_run
    fi
  fi
}

reload() {
  write_conf
  wg-quick down wg0 2>/dev/null || true
  wg-quick up wg0
  if [ "${AWG:-0}" = "1" ] && [ -f "$AWG_SERVICE" ]; then
    systemctl restart awg0.service 2>/dev/null || true
  fi
}

add_peer() {
  local name=$1 pub=$2 ip=$3 lan=$4 ep=$5 type=$6 proto=$7
  echo "$name|$pub|$ip|$lan|$ep|$type|$(date +%F)|$proto|1" >> "$PEERS_FILE"
  reload
}

validate_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*|.*|..|*' '*) return 1 ;;
  esac
  [ ${#1} -le 32 ]
}

fmt_endpoint() {
  local h=$1 p=$2
  case "$h" in
    \[*\]) echo "$h:$p" ;;
    *:*) echo "[$h]:$p" ;;
    *) echo "$h:$p" ;;
  esac
}

gen_client_conf() {
  local name=$1 priv=$2 ip=$3 proto=${4:-wg}
  local srv_pub host ep _net _prefix _port lan_list="" lans l
  srv_pub=$(cat "$SERVER_PUB_FILE")
  host="$SERVER_HOST"
  if [ "$proto" = "awg" ]; then
    _net=$AWG_NET
    _prefix=$AWG_PREFIX
    _port=$AWG_PORT
    [ -n "$host" ] || host="$AWG_NET.1"
  else
    _net=$NET
    _prefix=$PREFIX
    _port=$PORT
    [ -n "$host" ] || host="$NET.1"
  fi
  ep=$(fmt_endpoint "$host" "$_port")
  lans=$(awk -F'|' '$6=="router" && $4!="" {print $4}' "$PEERS_FILE" | sort -u)
  for l in $lans; do
    lan_list="$lan_list, $(net_of "$l")"
  done
  if [ "$proto" = "awg" ]; then
    cat > "$CLIENTS_DIR/$name.conf" <<EOF
[Interface]
PrivateKey = $priv
Address = $ip/$_prefix
DNS = $DNS1, $DNS2
MTU = $AWG_MTU
Jc = $AWG_JC
Jmin = $AWG_JMIN
Jmax = $AWG_JMAX
S1 = $AWG_S1
S2 = $AWG_S2
H1 = $AWG_H1
H2 = $AWG_H2
H3 = $AWG_H3
H4 = $AWG_H4

[Peer]
PublicKey = $srv_pub
Endpoint = $ep
AllowedIPs = $_net.0/$_prefix$lan_list
PersistentKeepalive = 25
EOF
  else
    cat > "$CLIENTS_DIR/$name.conf" <<EOF
[Interface]
PrivateKey = $priv
Address = $ip/$_prefix
DNS = $DNS1, $DNS2

[Peer]
PublicKey = $srv_pub
Endpoint = $ep
AllowedIPs = $_net.0/$_prefix$lan_list
PersistentKeepalive = 25
EOF
  fi
}

cmd_install() {
  [ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }

  while [ $# -gt 0 ]; do
    case "$1" in
      --host) SERVER_HOST="$2"; shift 2 ;;
      --port) PORT="$2"; shift 2 ;;
      --net) NET="$2"; shift 2 ;;
      --prefix) PREFIX="$2"; shift 2 ;;
      *) echo "unknown option: $1"; exit 1 ;;
    esac
  done

  mkdir -p "$STATE_DIR" "$CLIENTS_DIR" "$STATE_DIR/configs"
  touch "$PEERS_FILE"

  echo "==> Installing packages..."
  apt-get update -y
  apt-get install -y wireguard-tools openssl iptables python3 curl

  echo "==> Enabling IP forwarding..."
  sysctl -w net.ipv4.ip_forward=1
  grep -q '^net.ipv4.ip_forward=1' /etc/sysctl.conf 2>/dev/null || echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf

  mkdir -p /etc/wireguard

  if [ ! -f "$SERVER_KEY_FILE" ]; then
    echo "==> Generating server keys..."
    umask 077
    wg genkey > "$SERVER_KEY_FILE"
    wg pubkey < "$SERVER_KEY_FILE" > "$SERVER_PUB_FILE"
  fi
  [ -s "$SERVER_KEY_FILE" ] || { echo "ERROR: failed to create server key"; exit 1; }

  if [ -z "$SERVER_HOST" ]; then
    echo "==> Detecting public IPv4..."
    SERVER_HOST=$(curl -4 -s --max-time 5 https://ifconfig.me 2>/dev/null || true)
    [ -z "$SERVER_HOST" ] && SERVER_HOST=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || true)
    [ -z "$SERVER_HOST" ] && SERVER_HOST=$(curl -4 -s --max-time 5 https://icanhazip.com 2>/dev/null || true)
    if [ -z "$SERVER_HOST" ]; then
      SERVER_HOST=$(ip -o -4 addr show "$(detect_main_iface)" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    fi
  fi

  cat > "$CONFIG_FILE" <<EOF
NET=$NET
PREFIX=$PREFIX
PORT=$PORT
API_PORT=$API_PORT
DNS1=$DNS1
DNS2=$DNS2
SERVER_HOST=$SERVER_HOST
AWG=0
AWG_MODE=auto
AWG_NET=$AWG_NET
AWG_PREFIX=$AWG_PREFIX
AWG_PORT=$AWG_PORT
AWG_MTU=$AWG_MTU
AWG_JC=$AWG_JC
AWG_JMIN=$AWG_JMIN
AWG_JMAX=$AWG_JMAX
AWG_S1=$AWG_S1
AWG_S2=$AWG_S2
AWG_H1=$AWG_H1
AWG_H2=$AWG_H2
AWG_H3=$AWG_H3
AWG_H4=$AWG_H4
EOF

  if [ ! -f "$TOKEN_FILE" ]; then
    umask 077
    openssl rand -hex 24 > "$TOKEN_FILE"
  fi

  ADMIN_PASS="${ADMIN_PASS:-$(cat "$TOKEN_FILE")}"
  if grep -q '^ADMIN_PASS=' "$CONFIG_FILE"; then
    sed -i "s/^ADMIN_PASS=.*/ADMIN_PASS=$ADMIN_PASS/" "$CONFIG_FILE"
  else
    echo "ADMIN_PASS=$ADMIN_PASS" >> "$CONFIG_FILE"
  fi

  mkdir -p /etc/wireguard
  write_conf
  echo "==> Starting wg-quick@wg0..."
  wg-quick down wg0 2>/dev/null || true
  wg-quick up wg0 || { echo "ERROR: wg-quick up failed. On older kernels install linux-modules-extra-$(uname -r)."; exit 1; }
  systemctl enable wg-quick@wg0 >/dev/null 2>&1 || true

  cmd_install_api
  cmd_install_firewall

  local ep_end ep_api
  ep_end=$(fmt_endpoint "$SERVER_HOST" "$PORT")
  ep_api=$(fmt_endpoint "$SERVER_HOST" "$API_PORT")

  cat <<EOF

=== wgman installed ===
Server public key: $(cat "$SERVER_PUB_FILE")
WireGuard network: $NET.1/$PREFIX   port: $PORT/udp
Endpoint (for clients): $ep_end
Web UI: https://$ep_api    (admin password: $ADMIN_PASS)
API URL (router registration): https://$ep_api/register
API token: $(cat "$TOKEN_FILE")

On an OpenWrt router, run one command:
  sh install-router.sh https://$ep_api/register $(cat "$TOKEN_FILE") router-name
EOF
}

cmd_install_api() {
  local cert="$STATE_DIR/server.crt" key="$STATE_DIR/server.key"
  if [ -f "$(dirname "$0")/webui.py" ]; then
    cp "$(dirname "$0")/webui.py" "$WG_DIR/webui.py"
  fi
  [ -f "$WG_DIR/webui.py" ] || { echo "ERROR: webui.py not found next to wgman"; exit 1; }
  python3 -m py_compile "$WG_DIR/webui.py" || { echo "ERROR: webui.py syntax error"; exit 1; }
  if [ ! -f "$cert" ] || [ ! -f "$key" ]; then
    echo "==> Generating self-signed certificate for API..."
    openssl req -x509 -newkey rsa:2048 -keyout "$key" -out "$cert" -days 3650 -nodes \
      -subj "/CN=$SERVER_HOST" \
      -addext "subjectAltName=DNS:$SERVER_HOST,IP:$SERVER_HOST,IP:127.0.0.1" 2>/dev/null \
      || openssl req -x509 -newkey rsa:2048 -keyout "$key" -out "$cert" -days 3650 -nodes -subj "/CN=$SERVER_HOST"
    chmod 600 "$key"
  fi
  cat > /etc/systemd/system/wgman-api.service <<EOF
[Unit]
Description=wgman web UI and registration API
After=network.target
[Service]
ExecStart=/usr/bin/python3 $WG_DIR/webui.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now wgman-api.service >/dev/null 2>&1 || true
  echo "==> wgman-api.service started"
}

cmd_install_firewall() {
  cat > "$WG_DIR/firewall.sh" <<'SH'
#!/usr/bin/env bash
set -e
. /opt/wgman/state/config
iptables -C INPUT -p udp --dport "$PORT" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$PORT" -j ACCEPT
iptables -C INPUT -p tcp --dport "$API_PORT" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$API_PORT" -j ACCEPT
if [ "${AWG:-0}" = "1" ] && [ -n "${AWG_PORT:-}" ]; then
  iptables -C INPUT -p udp --dport "$AWG_PORT" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$AWG_PORT" -j ACCEPT
fi
SH
  chmod +x "$WG_DIR/firewall.sh"
  cat > /etc/systemd/system/wgman-firewall.service <<EOF
[Unit]
Description=wgman firewall rules
After=network.target
[Service]
Type=oneshot
ExecStart=$WG_DIR/firewall.sh
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now wgman-firewall.service >/dev/null 2>&1 || true
  echo "==> firewall rules applied"
}

ensure_awg_bins() {
  if ! command -v awg >/dev/null 2>&1; then
    echo "==> Building AmneziaWG tools (awg/awg-quick)..."
    apt-get update -y
    apt-get install -y golang-go build-essential git
    rm -rf /tmp/awg-build
    git clone --depth 1 https://github.com/amnezia-vpn/amneziawg-tools /tmp/awg-build/tools
    ( cd /tmp/awg-build/tools/src && make && make PREFIX=/usr/local install )
    command -v awg >/dev/null 2>&1 || { echo "ERROR: awg build failed"; exit 1; }
  fi
  if [ "${AWG_MODE:-auto}" != "native" ] && ! command -v amneziawg-go >/dev/null 2>&1; then
    echo "==> Building amneziawg-go (userspace)..."
    apt-get install -y golang-go 2>/dev/null || true
    git clone --depth 1 https://github.com/amnezia-vpn/amneziawg-go /tmp/awg-build/go
    ( cd /tmp/awg-build/go && go build -trimpath -o /usr/local/bin/amneziawg-go . )
  fi
}

ensure_awg_service() {
  mkdir -p /etc/amneziawg
  write_awg_down
  if [ "${AWG_MODE:-auto}" = "native" ]; then
    write_awg_up
    cat > "$AWG_SERVICE" <<EOF
[Unit]
Description=AmneziaWG awg0 (kernel)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$AWG_UP
ExecStop=$AWG_DOWN
[Install]
WantedBy=multi-user.target
EOF
  else
    write_awg_run
    cat > "$AWG_SERVICE" <<EOF
[Unit]
Description=AmneziaWG awg0 (userspace)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=$AWG_RUN
ExecStopPost=$AWG_DOWN
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=10
StartLimitBurst=10
[Install]
WantedBy=multi-user.target
EOF
  fi
  systemctl daemon-reload
  systemctl enable awg0.service >/dev/null 2>&1 || true
}

set_cfg() {
  local key=$1 val=$2
  if grep -q "^$key=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i "s/^$key=.*/$key=$val/" "$CONFIG_FILE"
  else
    echo "$key=$val" >> "$CONFIG_FILE"
  fi
}

cmd_awg() {
  local action="${1:-}"
  case "$action" in
    on)
      [ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }
      if kernel_has_awg; then
        AWG_MODE=native
      else
        AWG_MODE=userspace
      fi
      systemctl stop awg0.service 2>/dev/null || true
      systemctl reset-failed awg0.service 2>/dev/null || true
      ip link del awg0 2>/dev/null || true
      rm -f /var/run/amneziawg/awg0.sock 2>/dev/null || true
      set_cfg AWG_MODE "$AWG_MODE"
      set_cfg AWG 1
      . "$CONFIG_FILE"
      ensure_awg_bins
      ensure_awg_service
      write_conf
      systemctl restart awg0.service 2>/dev/null || true
      echo "AWG enabled ($AWG_MODE): net $AWG_NET.0/$AWG_PREFIX, port $AWG_PORT/udp"
      echo "On the router: sh install-router.sh <api_url> <token> name --awg"
      ;;
    off)
      [ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }
      systemctl disable --now awg0.service 2>/dev/null || true
      rm -f "$AWG_SERVICE"
      ip link del awg0 2>/dev/null || true
      set_cfg AWG 0
      . "$CONFIG_FILE"
      write_conf
      echo "AWG disabled"
      ;;
    status)
      if [ "${AWG:-0}" = "1" ]; then
        echo "AWG: enabled (${AWG_MODE:-auto})"
        echo "net:  $AWG_NET.0/$AWG_PREFIX"
        echo "port: $AWG_PORT/udp"
        if [ -f "$AWG_SERVICE" ] && systemctl is-active --quiet awg0.service 2>/dev/null; then
          echo "service: active"
        else
          echo "service: inactive"
        fi
        awk -F'|' '$8=="awg" {printf "peer: %-18s %s\n",$1,$3}' "$PEERS_FILE" 2>/dev/null
      else
        echo "AWG: disabled"
      fi
      ;;
    *) echo "usage: wgman awg <on|off|status>"; exit 1 ;;
  esac
}

cmd_add() {
  local name="" proto="wg"
  while [ $# -gt 0 ]; do
    case "$1" in
      --awg) proto="awg"; shift ;;
      *) [ -z "$name" ] && name="$1" || { echo "usage: wgman add <name> [--awg]"; exit 1; }; shift ;;
    esac
  done
  [ -n "$name" ] || { echo "usage: wgman add <name> [--awg]"; exit 1; }
  validate_name "$name" || { echo "invalid name (use A-Za-z0-9_.-)"; exit 1; }
  grep -q "^$name|" "$PEERS_FILE" && { echo "peer '$name' already exists"; exit 1; }
  local priv pub ip net=$NET
  [ "$proto" = "awg" ] && net=$AWG_NET
  priv=$(wg genkey)
  pub=$(printf '%s' "$priv" | wg pubkey)
  ip=$(next_ip "$net") || { echo "no free address in $net.0/$PREFIX"; exit 1; }
  add_peer "$name" "$pub" "$ip" "" "" "client" "$proto"
  gen_client_conf "$name" "$priv" "$ip" "$proto"
  echo "=== $proto client config for $name ($ip) ==="
  cat "$CLIENTS_DIR/$name.conf"
  echo
  echo "Saved to $CLIENTS_DIR/$name.conf"
}

cmd_client() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: wgman client <name>"; exit 1; }
  local line fname fpub fip flan fep ftype fproto priv
  line=$(grep "^$name|" "$PEERS_FILE" || true)
  [ -n "$line" ] || { echo "no such peer: $name"; exit 1; }
  IFS='|' read -r fname fpub fip flan fep ftype _ fproto <<< "$line"
  [ "$ftype" = "client" ] || { echo "$name is a router, not a client"; exit 1; }
  [ -n "${fproto:-}" ] || fproto="wg"
  priv=$(sed -n 's/^PrivateKey = //p' "$CLIENTS_DIR/$name.conf" 2>/dev/null | head -n1)
  [ -n "$priv" ] || { echo "client config for $name not found on server"; exit 1; }
  gen_client_conf "$name" "$priv" "$fip" "$fproto"
  echo "=== $fproto client config for $name ==="
  cat "$CLIENTS_DIR/$name.conf"
  echo
  echo "Saved to $CLIENTS_DIR/$name.conf"
}

cmd_ip() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: wgman ip <name>"; exit 1; }
  awk -F'|' -v n="$name" '$1==n {print $3; exit}' "$PEERS_FILE"
}

cmd_router() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: wgman router <name>"; exit 1; }
  awk -F'|' -v n="$name" '$1==n {printf "name=%s\nip=%s\nlan=%s\nendpoint=%s\ntype=%s\n",$1,$3,$4,$5,$6}' "$PEERS_FILE"
}

cmd_remove() {
  local sel="${1:-}"
  [ -n "$sel" ] || { echo "usage: wgman remove <name|ip>"; exit 1; }
  if ! grep -Eq "^$sel|" "$PEERS_FILE" && ! grep -Eq "\\|$sel\\|" "$PEERS_FILE"; then
    echo "no such peer: $sel"
    exit 1
  fi
  sed -i "/^$sel|/d; /|$sel|/d" "$PEERS_FILE"
  rm -f "$CLIENTS_DIR/$sel.conf" "$STATE_DIR/configs/$sel.conf"
  reload
  echo "removed: $sel"
}

cmd_list() {
  printf '%-18s %-14s %-18s %-22s %s\n' NAME IP LAN ENDPOINT TYPE
  while IFS='|' read -r n p ip lan ep ty _ en; do
    [ -n "$n" ] && printf '%-18s %-14s %-18s %-22s %s\n' "$n" "$ip" "$lan" "$ep" "$ty$([ "$en" = "0" ] && echo " (off)")"
  done < "$PEERS_FILE"
}

cmd_routers() {
  printf '%-18s %-14s %-18s %s %s\n' NAME IP LAN REGISTERED STATE
  while IFS='|' read -r n p ip lan ep ty d en; do
    [ -n "$n" ] && [ "$ty" = "router" ] && printf '%-18s %-14s %-18s %s %s\n' "$n" "$ip" "$lan" "$d" "$([ "$en" = "0" ] && echo off || echo on)"
  done < "$PEERS_FILE"
}

cmd_token() {
  if [ "${1:-}" = "new" ]; then
    umask 077
    openssl rand -hex 24 > "$TOKEN_FILE"
    echo "new token generated"
  fi
  cat "$TOKEN_FILE"
}

cmd_host() {
  local host="${1:-}"
  [ -n "$host" ] || { echo "usage: wgman host <hostname-or-ip>"; exit 1; }
  sed -i "s/^SERVER_HOST=.*/SERVER_HOST=$host/" "$CONFIG_FILE"
  echo "SERVER_HOST set to $host"
  echo "Regenerate client configs with: wgman client <name>"
}

cmd_peer_set() {
  local name="${1:-}" val="${2:-}"
  [ -n "$name" ] || { echo "usage: wgman <enable|disable> <name>"; exit 1; }
  case "$val" in 1|0) ;; *) echo "usage: wgman <enable|disable> <name>"; exit 1 ;; esac
  [ "$(id -u)" = "0" ] || { echo "ERROR: run as root"; exit 1; }
  grep -q "^$name|" "$PEERS_FILE" || { echo "no such peer: $name"; exit 1; }
  awk -F'|' -v n="$name" -v v="$val" 'BEGIN{OFS="|"} $1==n {if ($9=="") $9=1; $9=v} {print}' "$PEERS_FILE" > "$PEERS_FILE.tmp" && mv "$PEERS_FILE.tmp" "$PEERS_FILE"
  reload
  echo "$name: $([ "$val" = "1" ] && echo enabled || echo disabled)"
}

cmd_register() {
  local name="${1:-}" pub="${2:-}" lan="${3:-}" ep="${4:-}" proto="${5:-wg}"
  validate_name "$name" || { echo "invalid name"; exit 1; }
  case "$pub" in
    *[!A-Za-z0-9+/=]*|'' ) echo "invalid public key"; exit 1 ;;
  esac
  [ ${#pub} -eq 44 ] || { echo "invalid public key length"; exit 1; }
  local net=$NET
  [ "$proto" = "awg" ] && net=$AWG_NET
  if [ -n "$lan" ]; then
    awk -F'|' -v n="$name" -v l="$lan" '$1!=n && $4==l && $6=="router" {print "WARNING: LAN " l " already used by " $1 > "/dev/stderr"}' "$PEERS_FILE"
  fi
  local ip existing
  existing=$(grep "^$name|" "$PEERS_FILE" || true)
  if [ -n "$existing" ]; then
    ip=$(printf '%s' "$existing" | cut -d'|' -f3)
    awk -F'|' -v n="$name" -v p="$pub" -v i="$ip" -v l="$lan" -v e="$ep" -v t="router" -v d="$(date +%F)" -v pr="$proto" 'BEGIN{OFS="|"} $1==n {$2=p; $3=i; $4=l; $5=e; $6=t; $7=d; $8=pr; if ($9=="") $9=1} {print}' "$PEERS_FILE" > "$PEERS_FILE.tmp" && mv "$PEERS_FILE.tmp" "$PEERS_FILE"
    reload
  else
    ip=$(next_ip "$net") || { echo "no free address in $net.0/$PREFIX"; exit 1; }
    add_peer "$name" "$pub" "$ip" "$lan" "$ep" "router" "$proto"
  fi
  echo "OK $ip"
}

cmd_router_new() {
  local name="${1:-}" lan="${2:-}" proto="${3:-wg}"
  [ -n "$name" ] || { echo "usage: wgman router-new <name> [lan_cidr]"; exit 1; }
  validate_name "$name" || { echo "invalid name (use A-Za-z0-9_.-)"; exit 1; }
  grep -q "^$name|" "$PEERS_FILE" && { echo "peer '$name' already exists"; exit 1; }
  local priv pub ip srv_pub host net=$NET
  [ "$proto" = "awg" ] && net=$AWG_NET
  priv=$(wg genkey)
  pub=$(printf '%s' "$priv" | wg pubkey)
  ip=$(next_ip "$net") || { echo "no free address in $net.0/$PREFIX"; exit 1; }
  if [ -n "$lan" ]; then
    awk -F'|' -v n="$name" -v l="$lan" '$1!=n && $4==l && $6=="router" {print "WARNING: LAN " l " already used by " $1 > "/dev/stderr"}' "$PEERS_FILE"
  fi
  add_peer "$name" "$pub" "$ip" "$lan" "" "router" "$proto"
  srv_pub=$(cat "$SERVER_PUB_FILE")
  host="$SERVER_HOST"
  mkdir -p "$STATE_DIR/configs"
  if [ "$proto" = "awg" ]; then
    [ -n "$host" ] || host="$AWG_NET.1"
    ep=$(fmt_endpoint "$host" "$AWG_PORT")
    cat > "$STATE_DIR/configs/$name.conf" <<EOF
[Interface]
PrivateKey = $priv
Address = $ip/$AWG_PREFIX
DNS = $DNS1, $DNS2
MTU = $AWG_MTU
Jc = $AWG_JC
Jmin = $AWG_JMIN
Jmax = $AWG_JMAX
S1 = $AWG_S1
S2 = $AWG_S2
H1 = $AWG_H1
H2 = $AWG_H2
H3 = $AWG_H3
H4 = $AWG_H4

[Peer]
PublicKey = $srv_pub
Endpoint = $ep
AllowedIPs = $AWG_NET.0/$AWG_PREFIX
PersistentKeepalive = 25
EOF
    echo "OK $ip (awg)"
  else
    [ -n "$host" ] || host="$NET.1"
    ep=$(fmt_endpoint "$host" "$PORT")
    cat > "$STATE_DIR/configs/$name.conf" <<EOF
[Interface]
PrivateKey = $priv
Address = $ip/$PREFIX
DNS = $DNS1, $DNS2

[Peer]
PublicKey = $srv_pub
Endpoint = $ep
AllowedIPs = $NET.0/$PREFIX
PersistentKeepalive = 25
EOF
    echo "OK $ip"
  fi
  echo "conf: $STATE_DIR/configs/$name.conf"
}

cmd_config() {
  local name="${1:-}" ftype
  [ -n "$name" ] || { echo "usage: wgman config <name>"; exit 1; }
  ftype=$(awk -F'|' -v n="$name" '$1==n {print $6}' "$PEERS_FILE")
  case "$ftype" in
    client) cat "$CLIENTS_DIR/$name.conf" ;;
    router) cat "$STATE_DIR/configs/$name.conf" ;;
    *) echo "no such peer: $name"; exit 1 ;;
  esac
}

load_config

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  add) shift; cmd_add "$@" ;;
  client) shift; cmd_client "$@" ;;
  list) shift; cmd_list ;;
  routers) shift; cmd_routers ;;
  ip) shift; cmd_ip "$@" ;;
  router) shift; cmd_router "$@" ;;
  router-new) shift; cmd_router_new "$@" ;;
  config) shift; cmd_config "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  token) shift; cmd_token "$@" ;;
  host) shift; cmd_host "$@" ;;
  awg) shift; cmd_awg "$@" ;;
  enable) shift; cmd_peer_set "$@" 1 ;;
  disable) shift; cmd_peer_set "$@" 0 ;;
  _register) shift; cmd_register "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
